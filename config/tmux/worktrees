#!/usr/bin/env bash 

createWorktree() {
  new_path=$1
  name=$2
  git worktree add "$new_path" "$name" --quiet
  return $?
}

worktreeExists() {
  worktree_path=$1
  git worktree list --porcelain | grep '^worktree ' | sed 's/^worktree //' | grep -Fxq "$worktree_path"
}

deleteWorktree() {
  worktrees=()
  while IFS= read -r path; do
    if [[ $path != "${main_repo_root}" ]]; then
      worktrees+=("$path")
    fi
  done < <(git worktree list --porcelain | grep '^worktree ' | sed 's/^worktree //')

  if [[ ${#worktrees[@]} -eq 0 ]]; then
    echo "ERROR: no linked worktrees to delete"
    exit 1
  fi

  target=$(printf "%s\n" "${worktrees[@]}" | fzf) || exit 0

  read -rp "Remove worktree ${target}? [y/N] " confirm
  if [[ $confirm != "y" && $confirm != "Y" ]]; then
    exit 0
  fi

  if ! git worktree remove "${target}"; then
    read -rp "Worktree is dirty. Force remove anyway? [y/N] " confirm
    if [[ $confirm == "y" || $confirm == "Y" ]]; then
      git worktree remove --force "${target}"
    else
      exit 0
    fi
  fi

  git worktree prune

  session_name=$(basename "${target}" | tr . _)
  if tmux has-session -t "${session_name}" 2>/dev/null; then
    tmux kill-session -t "${session_name}"
  fi

  echo "Deleted worktree ${target}"
}

# make sure we're in a git repo
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  echo "ERROR: worktrees can only be run from a git repo"
  exit 1
fi


if [[ $# -eq 1 ]]; then
    selected=$1
else
    # list the branches for the repo
    branches=$(git branch --list --format "%(refname:lstrip=2)")

    # add "new" and "delete" options
    branches=("$branches" new delete)

    # prompt user for their selection
    selected=$(printf "%s\n" "${branches[@]}" | fzf) || exit 0
fi

if [[ -z $selected ]]; then
    exit 0
fi

main_repo_root=$(git rev-parse --path-format=absolute --git-common-dir)
main_repo_root=${main_repo_root%/.git}
git_repo_parent=$(dirname "$main_repo_root")
git_repo_name=$(basename "$main_repo_root")

getDefaultBranch() {
  branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@refs/remotes/origin/@@')
  if [[ -z $branch ]]; then
    if git rev-parse --verify --quiet main > /dev/null 2>&1; then
      branch="main"
    elif git rev-parse --verify --quiet master > /dev/null 2>&1; then
      branch="master"
    else
      branch="main"
    fi
  fi
  echo "$branch"
}

if [[ $selected == "new" ]]; then
  default_branch=$(getDefaultBranch)

  while true; do
    # prompt for new branch name
    read -rp "New Worktree Branch Name: " new_branch_name

    if [[ -z $new_branch_name ]]; then
      echo "ERROR: branch name cannot be empty"
      continue
    fi

    if ! git check-ref-format --branch "$new_branch_name" > /dev/null 2>&1; then
      echo "ERROR: invalid branch name: $new_branch_name"
      continue
    fi

    if git rev-parse --verify --quiet "refs/heads/$new_branch_name" > /dev/null 2>&1; then
      echo "ERROR: branch $new_branch_name already exists"
      continue
    fi

    break
  done

  # prompt for source branch (default to default branch for repo)
  read -rp "Source Branch Name [$default_branch]: " source_branch_name

  if [[ -z $source_branch_name ]]; then
    source_branch_name=$default_branch
  fi

  if ! git rev-parse --verify --quiet "$source_branch_name" > /dev/null 2>&1; then
    echo "ERROR: source branch $source_branch_name does not exist"
    exit 1
  fi

  if ! git branch "${new_branch_name}" "${source_branch_name}"; then
    echo "ERROR: could not create branch ${new_branch_name}"
    exit 1
  fi
  selected="${new_branch_name}"
elif [[ $selected == "delete" ]]; then
  deleteWorktree
  exit 0
fi

worktree_name=${git_repo_name}-${selected}
worktree_path="$git_repo_parent/$worktree_name"

# check if there is already a worktree for that branch. if not, create it
if ! worktreeExists "${worktree_path}"; then
  if ! git rev-parse --verify --quiet "$selected" > /dev/null 2>&1; then
    echo "ERROR: branch ${selected} does not exist"
    exit 1
  fi
  if ! createWorktree "${worktree_path}" "${selected}"; then
    echo "ERROR: branch ${selected} already checked out in another worktree? Aborting."
    exit 1
  fi
fi

tmux-sessionizer "${worktree_path}"
